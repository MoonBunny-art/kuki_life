-- ANTI-CRASH SETTINGS
local MIN_CHECK_DISTANCE = 13
local ROBOT_PAUSE_DISTANCE = 25   -- Studs
local ROBOT_PAUSE_SECONDS = 1     -- Dauer der Pause
local antiCrashPausedUntil = 0
local MAX_CHECK_DISTANCE = 60
local LOOKAHEAD_SECONDS = 0
local SIDE_RAY_OFFSET = 5
local RETREAT_DISTANCE = 5
local STOP_SPEED = 5
local MIN_MOVE_SPEED = 25
local antiCrashBusy = false

-- Bewegungsrichtung ermitteln (unabhängig davon, wohin der
-- Körper / die Nase des Scooters schaut).
local function getMovementDirection(vehicle, seat, root, humanoid)
    -- 1) Tatsächliche Bewegung des Fahrzeugs
    local vel = root.AssemblyLinearVelocity
    local horizontal = Vector3.new(vel.X, 0, vel.Z)

    if horizontal.Magnitude > MIN_MOVE_SPEED then
        return horizontal.Unit, horizontal.Magnitude
    end

    -- 2) Eingabe des Spielers (Steuerrichtung)
    if humanoid then
        local move = humanoid.MoveDirection
        local flat = Vector3.new(move.X, 0, move.Z)

        if flat.Magnitude > 0.1 then
            return flat.Unit, 0
        end
    end

    -- 3) Gas / Lenkung vom VehicleSeat
    if seat and seat:IsA("VehicleSeat") then
        local cf = vehicle:GetPivot()
        local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
        local right = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)
        local dir = look * seat.ThrottleFloat + right * seat.SteerFloat

        if dir.Magnitude > 0.1 then
            return dir.Unit, 0
        end
    end

    return nil, 0
end

local function runAntiCrash()
    if antiCrashBusy
        or not ANTI_CRASH_ENABLED
        or os.clock() < antiCrashPausedUntil
        or not gui.Parent then
        return
    end

    local vehicle, seat, humanoid = getVehicle()

    if not vehicle or not seat or not vehicle.PrimaryPart then
        return
    end

    local root = vehicle.PrimaryPart
    local pivot = vehicle:GetPivot()

    local direction, speed =
        getMovementDirection(vehicle, seat, root, humanoid)

    -- Keine Bewegung = nichts zu schützen
    if not direction then return end

    local checkDistance = math.clamp(
        speed * LOOKAHEAD_SECONDS,
        MIN_CHECK_DISTANCE,
        MAX_CHECK_DISTANCE
    )

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {
        vehicle,
        player.Character
    }
    params.IgnoreWater = true

    local origin = pivot.Position + Vector3.new(0, 1.5, 0)
    local sideways = direction:Cross(Vector3.yAxis)

    -- Drei Strahlen: Mitte, links, rechts (relativ zur Bewegung)
    local offsets = {
        Vector3.zero,
        sideways * SIDE_RAY_OFFSET,
        -sideways * SIDE_RAY_OFFSET
    }

    local hit

    for _, offset in ipairs(offsets) do
        hit = workspace:Raycast(
            origin + offset,
            direction * checkDistance,
            params
        )

        if hit then break end
    end

    if not hit then return end

    antiCrashBusy = true

    -- Entgegen der Bewegungsrichtung zurücksetzen
    vehicle:PivotTo(pivot + (-direction * RETREAT_DISTANCE))

    local holdPivot = vehicle:GetPivot()
    local elapsed = 0
    local holdTimeout = 0.6

    while gui.Parent and vehicle.Parent
        and seat.Parent and elapsed < holdTimeout do

        local dt = RunService.Heartbeat:Wait()
        elapsed += dt

        if not root.Parent then break end

        local currentVehicle = getVehicle()

        if currentVehicle ~= vehicle then
            break
        end

        local currentSpeed = root.AssemblyLinearVelocity.Magnitude

        if currentSpeed <= STOP_SPEED then
            break
        end

        vehicle:PivotTo(holdPivot)

        root.AssemblyLinearVelocity *= math.max(0, 1 - dt * 3)
        root.AssemblyAngularVelocity *= math.max(0, 1 - dt * 3)
    end

    antiCrashBusy = false
end

-- ANTI-FALL
local antiFallBusy = false

local function runAntiFall()
    if not antiFallEnabled
        or antiFallBusy
        or not gui.Parent then
        return
    end

    local vehicle, seat, humanoid = getVehicle()

    if not vehicle or not seat or not humanoid
        or humanoid.Health <= 0
        or not vehicle.PrimaryPart then
        return
    end

    local pivot = vehicle:GetPivot()
    local pitch, yaw, roll = pivot:ToOrientation()

    if pitch > MAX_BACKWARD_TILT then
        antiFallBusy = true

        local correctedPivot = CFrame.new(pivot.Position)
            * CFrame.fromOrientation(
                MAX_BACKWARD_TILT,
                yaw,
                roll
            )

        local currentVehicle, currentSeat, currentHumanoid =
            getVehicle()

        if currentVehicle == vehicle
            and currentSeat == seat
            and currentHumanoid == humanoid
            and vehicle.Parent
            and vehicle.PrimaryPart then

            vehicle:PivotTo(
                pivot:Lerp(
                    correctedPivot,
                    ANTI_FALL_SMOOTHNESS
                )
            )

            local root = vehicle.PrimaryPart
            local av = root.AssemblyAngularVelocity

            root.AssemblyAngularVelocity = Vector3.new(
                av.X * ANTI_FALL_ANGULAR_DAMPING,
                av.Y,
                av.Z * ANTI_FALL_ANGULAR_DAMPING
            )
        end

        antiFallBusy = false
    end
end

-- ANTI RAGDOLL
local RAGDOLL_STATES = {
    Enum.HumanoidStateType.Ragdoll,
    Enum.HumanoidStateType.FallingDown,
    Enum.HumanoidStateType.PlatformStanding,
    Enum.HumanoidStateType.Physics,
}

local ragdollConnections = {}
local ragdollCharConn
local jointSnapshot = {}
local ballSockets = {}

local function isRagdollState(state)
    for _, s in ipairs(RAGDOLL_STATES) do
        if s == state then return true end
    end
    return false
end

local function isRagdollName(name)
    return string.find(string.lower(name), "ragdoll", 1, true) ~= nil
end

local function ragdollConnect(signal, fn)
    table.insert(ragdollConnections, signal:Connect(fn))
end

local function setRagdollStatesEnabled(humanoid, enabled)
    for _, state in ipairs(RAGDOLL_STATES) do
        pcall(function()
            humanoid:SetStateEnabled(state, enabled)
        end)
    end
end

local function clearRagdollHooks()
    for _, c in ipairs(ragdollConnections) do
        c:Disconnect()
    end
    table.clear(ragdollConnections)
    table.clear(jointSnapshot)
    table.clear(ballSockets)
end

local function takeJointSnapshot(character)
    table.clear(jointSnapshot)

    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("Motor6D") and obj.Part0 and obj.Part1 then
            table.insert(jointSnapshot, {
                name = obj.Name,
                parent = obj.Parent,
                part0 = obj.Part0,
                part1 = obj.Part1,
                c0 = obj.C0,
                c1 = obj.C1,
                motor = obj,
            })
        end
    end
end

-- Stellt alle Gelenke wieder her. Gibt true zurück, wenn alle intakt sind.
local function restoreJoints()
    local healthy = #jointSnapshot > 0

    for _, e in ipairs(jointSnapshot) do
        local motor = e.motor

        if not motor or not motor.Parent then
            motor = nil

            if e.parent and e.parent.Parent then
                local existing = e.parent:FindFirstChild(e.name)

                if existing and existing:IsA("Motor6D") then
                    motor = existing
                end
            end

            if not motor
                and e.parent and e.parent.Parent
                and e.part0.Parent and e.part1.Parent then
                motor = Instance.new("Motor6D")
                motor.Name = e.name
                motor.Part0 = e.part0
                motor.Part1 = e.part1
                motor.C0 = e.c0
                motor.C1 = e.c1
                motor.Parent = e.parent
            end

            e.motor = motor
        end

        if motor then
            if motor.Part0 ~= e.part0 then motor.Part0 = e.part0 end
            if motor.Part1 ~= e.part1 then motor.Part1 = e.part1 end
            if not motor.Enabled then motor.Enabled = true end
        else
            healthy = false
        end
    end

    return healthy
end

local function disableBallSockets()
    for sock in pairs(ballSockets) do
        if sock.Parent then
            if sock.Enabled then
                sock.Enabled = false
            end
        else
            ballSockets[sock] = nil
        end
    end
end

local function standUp(humanoid, root, character)
    local healthy = restoreJoints()

    if healthy then
        disableBallSockets()
    end

    if humanoid.SeatPart then return end

    if humanoid.PlatformStand then
        humanoid.PlatformStand = false
    end

    if isRagdollState(humanoid:GetState()) then
        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end

    -- Flach am Boden: ganzes Modell aufrichten (nur bei intakten Gelenken)
    if healthy and root and not root.Anchored
        and root.CFrame.UpVector.Y < 0.4 then
        local cf = root.CFrame
        local flat = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)

        if flat.Magnitude < 0.1 then
            flat = Vector3.new(cf.UpVector.X, 0, cf.UpVector.Z)
        end

        if flat.Magnitude < 0.1 then
            flat = Vector3.zAxis
        end

        local pos = root.Position + Vector3.new(0, 3, 0)

        character:PivotTo(CFrame.lookAt(pos, pos + flat.Unit))
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

local function neutralize(obj)
    if obj:IsA("BallSocketConstraint") then
        ballSockets[obj] = true
    elseif obj:IsA("BoolValue") and isRagdollName(obj.Name) then
        obj.Value = false

        ragdollConnect(obj:GetPropertyChangedSignal("Value"), function()
            if antiRagdollEnabled and obj.Value then
                obj.Value = false
            end
        end)
    end
end

local function watchAttributes(inst)
    ragdollConnect(inst.AttributeChanged, function(name)
        if antiRagdollEnabled
            and isRagdollName(name)
            and inst:GetAttribute(name) == true then
            inst:SetAttribute(name, false)
        end
    end)

    for name, value in pairs(inst:GetAttributes()) do
        if isRagdollName(name) and value == true then
            inst:SetAttribute(name, false)
        end
    end
end

local function hookCharacter(character)
    if not character or not antiRagdollEnabled then return end

    local humanoid = character:WaitForChild("Humanoid", 5)
    local root = character:WaitForChild("HumanoidRootPart", 5)

    if not humanoid or not root or not antiRagdollEnabled then return end

    takeJointSnapshot(character)
    setRagdollStatesEnabled(humanoid, false)

    ragdollConnect(humanoid.StateChanged, function(_, new)
        if antiRagdollEnabled and isRagdollState(new) then
            print("[AntiRagdoll] blockiert Zustand:", tostring(new))
            standUp(humanoid, root, character)
        end
    end)

    ragdollConnect(
        humanoid:GetPropertyChangedSignal("PlatformStand"),
        function()
            if antiRagdollEnabled
                and humanoid.PlatformStand
                and not humanoid.SeatPart then
                humanoid.PlatformStand = false
            end
        end
    )

    ragdollConnect(character.DescendantAdded, function(obj)
        if antiRagdollEnabled then
            neutralize(obj)
        end
    end)

    -- Wird ein Gelenk entfernt: sofort wiederherstellen
    ragdollConnect(character.DescendantRemoving, function(obj)
        if antiRagdollEnabled and obj:IsA("Motor6D") then
            task.defer(function()
                if antiRagdollEnabled and character.Parent then
                    standUp(humanoid, root, character)
                end
            end)
        end
    end)

    for _, obj in ipairs(character:GetDescendants()) do
        neutralize(obj)
    end

    watchAttributes(character)
    watchAttributes(humanoid)
    watchAttributes(player)

    ragdollConnect(RunService.Heartbeat, function()
        if not antiRagdollEnabled
            or humanoid.Health <= 0
            or not character.Parent then
            return
        end

        setRagdollStatesEnabled(humanoid, false)
        standUp(humanoid, root, character)
    end)
end

local function startAntiRagdoll()
    clearRagdollHooks()

    if player.Character then
        task.spawn(hookCharacter, player.Character)
    end

    if ragdollCharConn then
        ragdollCharConn:Disconnect()
    end

    ragdollCharConn = player.CharacterAdded:Connect(function(character)
        clearRagdollHooks()
        task.wait(0.5)
        hookCharacter(character)
    end)
end

local function stopAntiRagdoll()
    clearRagdollHooks()

    if ragdollCharConn then
        ragdollCharConn:Disconnect()
        ragdollCharConn = nil
    end

    local character = player.Character
    local humanoid = character
        and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        setRagdollStatesEnabled(humanoid, true)
    end
end

-- ROBOT ESCAPE
local ESCAPE_TRIGGER_DISTANCE = 10
local ESCAPE_DISTANCE = 20
local ESCAPE_COOLDOWN = 0.35
local lastEscapeTime = 0

local function getHumanoidModel(inst)
    while inst and inst ~= workspace do
        if inst:IsA("Model")
            and inst:FindFirstChildOfClass("Humanoid") then
            return inst
        end

        inst = inst.Parent
    end

    return nil
end

local function isRobotModel(model)
    if not model then return false end
    if model == player.Character then return false end
    if Players:GetPlayerFromCharacter(model) then return false end

    local hum = model:FindFirstChildOfClass("Humanoid")

    return hum ~= nil and hum.Health > 0
end

local function makeOverlapParams(ignore)
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = ignore
    params.MaxParts = 300
    return params
end

local ESCAPE_LOOKAHEAD = 0.12
local robotCache = {}

local function registerRobot(inst)
    if inst:IsA("Humanoid")
        and inst.Parent
        and inst.Parent:IsA("Model") then
        robotCache[inst.Parent] = true
    end
end

task.spawn(function()
    for _, inst in ipairs(workspace:GetDescendants()) do
        registerRobot(inst)
    end
end)

local robotAddedConn = workspace.DescendantAdded:Connect(registerRobot)

local function findNearestRobot(position, radius)
    local bestModel, bestRoot, bestDist

    for model in pairs(robotCache) do
        if not model.Parent then
            robotCache[model] = nil
        elseif isRobotModel(model) then
            local r = model:FindFirstChild("HumanoidRootPart")
                or model.PrimaryPart

            if r then
                local predicted = r.Position
                    + r.AssemblyLinearVelocity * ESCAPE_LOOKAHEAD
                local d = math.min(
                    (r.Position - position).Magnitude,
                    (predicted - position).Magnitude
                )

                if d <= radius and (not bestDist or d < bestDist) then
                    bestModel, bestRoot, bestDist = model, r, d
                end
            end
        end
    end

    return bestModel, bestRoot
end

local function findFreeSpot(robotPos, away, size, refY, ignore)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = ignore
    rayParams.IgnoreWater = true

    local boxParams = makeOverlapParams(ignore)

    local distances = {
        ESCAPE_DISTANCE,
        ESCAPE_DISTANCE + 4,
        ESCAPE_DISTANCE + 8,
    }
    local angles = {
        0, 30, -30, 60, -60, 90, -90, 120, -120, 150, -150, 180
    }

    for _, dist in ipairs(distances) do
        for _, angle in ipairs(angles) do
            local dir = CFrame.Angles(0, math.rad(angle), 0)
                :VectorToWorldSpace(away)
            local flat = robotPos + dir * dist

            local result = workspace:Raycast(
                Vector3.new(flat.X, refY + 8, flat.Z),
                Vector3.new(0, -80, 0),
                rayParams
            )

            if result
                and result.Normal.Y > 0.85
                and math.abs(result.Position.Y - refY) < 15
                and not getHumanoidModel(result.Instance) then

                local spot = result.Position
                local boxCF = CFrame.new(
                    spot + Vector3.new(0, size.Y / 2 + 0.6, 0)
                )

                local blocked = false

                for _, part in ipairs(
                    workspace:GetPartBoundsInBox(boxCF, size, boxParams)
                ) do
                    if part.CanCollide then
                        blocked = true
                        break
                    end
                end

                if not blocked
                    and not findNearestRobot(
                        spot + Vector3.new(0, 3, 0),
                        ESCAPE_TRIGGER_DISTANCE
                    ) then
                    return spot
                end
            end
        end
    end

    return nil
end

local function runRobotEscape()
    if not robotEscapeEnabled or not gui.Parent then
        return
    end

    if os.clock() - lastEscapeTime < ESCAPE_COOLDOWN then
        return
    end

    local character = player.Character
    local humanoid = character
        and character:FindFirstChildOfClass("Humanoid")
    local root = character
        and character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root or humanoid.Health <= 0 then
        return
    end

    local vehicle = getVehicle()
    local subjectRoot = vehicle and vehicle.PrimaryPart or root

    local ignore = {character}

    if vehicle then
        table.insert(ignore, vehicle)
    end

    local origin = subjectRoot.Position

    local robot, robotRoot = findNearestRobot(
        origin,
        ESCAPE_TRIGGER_DISTANCE
    )

    if not robot then return end

    lastEscapeTime = os.clock()

    local away = Vector3.new(
        origin.X - robotRoot.Position.X,
        0,
        origin.Z - robotRoot.Position.Z
    )

    if away.Magnitude < 0.1 then
        local look = subjectRoot.CFrame.LookVector
        away = Vector3.new(look.X, 0, look.Z)
    end

    if away.Magnitude < 0.1 then
        away = Vector3.xAxis
    end

    away = away.Unit

    local size = vehicle and vehicle:GetExtentsSize()
        or Vector3.new(4, 5, 4)

    size = Vector3.new(
        math.clamp(size.X, 4, 14),
        math.clamp(size.Y, 5, 14),
        math.clamp(size.Z, 4, 14)
    )

    local pivot = vehicle and vehicle:GetPivot() or character:GetPivot()

    -- Höhe des Pivots über dem aktuellen Boden
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = ignore
    rayParams.IgnoreWater = true

    local down = workspace:Raycast(
        pivot.Position + Vector3.new(0, 2, 0),
        Vector3.new(0, -30, 0),
        rayParams
    )

    local offsetY = down and (pivot.Position.Y - down.Position.Y) or 3
    offsetY = math.clamp(offsetY, 1, 6)

    local spot = findFreeSpot(
        robotRoot.Position,
        away,
        size,
        origin.Y,
        ignore
    )

    if not spot then return end

    local newCFrame = CFrame.new(spot + Vector3.new(0, offsetY + 0.3, 0))
        * pivot.Rotation

    if vehicle then
        vehicle:PivotTo(newCFrame)
    else
        character:PivotTo(newCFrame)
    end

    subjectRoot.AssemblyLinearVelocity = Vector3.zero
    subjectRoot.AssemblyAngularVelocity = Vector3.zero

    status.Text = "POLICE ESCAPE: TELEPORTED"
    status.TextColor3 = GREEN

    task.delay(1.5, function()
        if gui.Parent then
            restoreStatus()
        end
    end)
end

-- GO TO KUKI
local KUKI_PROMPT_ACTION = "Enter"
local KUKI_PROMPT_KEY = Enum.KeyCode.E
local KUKI_TELEPORT_OFFSET = CFrame.new(0, 3, 0)
local KUKI_USE_NAME_FILTER = true
local KUKI_WAIT_ONE_FRAME = false
local KUKI_SECOND_PRESS_DELAY = 0.15

local KUKI_VEHICLE_NAMES = {
    ["g2"] = true,
    ["g2 ultra"] = true,
    ["g2 master"] = true,
    ["g2 max"] = true,
    ["duol lightning 3"] = true,
    ["g3"] = true,
    ["g4"] = true,
    ["g4 ultra"] = true,
    ["g5"] = true,
    ["g4 max"] = true,
    ["g4 pro"] = true,
}

local runKuki

do
    local function norm(s)
        return string.lower((tostring(s):gsub("^%s+", ""):gsub("%s+$", "")))
    end

    local myNames = { norm(player.Name), norm(player.DisplayName) }

    local function isMine(name)
        local n = norm(name)
        for _, mine in ipairs(myNames) do
            if n == "ride_" .. mine or n:find(mine, 1, true) then
                return true
            end
        end
        return false
    end

    local function belongsToMe(prompt, rootInst)
        local current = prompt.Parent
        while current and current ~= rootInst and current ~= workspace do
            if isMine(current.Name) then return true end
            current = current.Parent
        end
        return false
    end

    local function isVehicleInList(prompt)
        if KUKI_VEHICLE_NAMES[norm(prompt.ObjectText)] then return true end
        local current = prompt.Parent
        while current and current ~= workspace do
            if KUKI_VEHICLE_NAMES[norm(current.Name)] then return true end
            current = current.Parent
        end
        return false
    end

    local function isEnterPrompt(prompt)
        return prompt:IsA("ProximityPrompt")
            and prompt.ActionText == KUKI_PROMPT_ACTION
            and prompt.KeyboardKeyCode == KUKI_PROMPT_KEY
    end

    local function getPromptCFrame(prompt)
        local p = prompt.Parent
        if p and p:IsA("BasePart") then return p.CFrame end
        if p and p:IsA("Attachment") then return p.WorldCFrame end
        if p and p:IsA("Model") then return p:GetPivot() end
    end

    local function findMyPrompt()
        local rides = workspace:FindFirstChild("Rides") or workspace
        local total, mine = 0, 0

        for _, obj in ipairs(rides:GetDescendants()) do
            if isEnterPrompt(obj) then
                total += 1
                if belongsToMe(obj, rides) then
                    mine += 1
                    if not KUKI_USE_NAME_FILTER or isVehicleInList(obj) then
                        print(("[DEBUG] Gefunden: %s | ObjectText: %s")
                            :format(obj:GetFullName(), obj.ObjectText))
                        return obj
                    end
                end
            end
        end

        print(("[DEBUG] Enter-Knöpfe gesamt: %d | davon von mir (%s): %d")
            :format(total, player.Name, mine))
        return nil
    end

    local function pressPrompt(prompt)
        prompt.Enabled = true
        prompt.HoldDuration = 0
        prompt:InputHoldBegin()
        prompt:InputHoldEnd()
    end

    local kukiBusy = false

    local function runOnce()
        if kukiBusy then return end
        kukiBusy = true

        local character = player.Character
        local humanoid = character
            and character:FindFirstChildOfClass("Humanoid")

        if not character or not humanoid or humanoid.SeatPart then
            kukiBusy = false
            return
        end

        local prompt = findMyPrompt()
        if not prompt then
            warn("[DEBUG] Dein Fahrzeug wurde nicht gefunden (ist es gespawnt und geladen?)")
            status.Text = "KUKI: VEHICLE NOT FOUND"
            status.TextColor3 = RED
            kukiBusy = false
            return
        end

        local cf = getPromptCFrame(prompt)
        if cf then
            character:PivotTo(cf * KUKI_TELEPORT_OFFSET)
            if KUKI_WAIT_ONE_FRAME then task.wait() end
            if prompt.Parent then
                pressPrompt(prompt)
            end
        end

        kukiBusy = false
    end

    -- zweimal ausführen (zweites Mal wird übersprungen, wenn du schon sitzt)
    runKuki = function()
        runOnce()
        task.wait(KUKI_SECOND_PRESS_DELAY)
        runOnce()
    end
end

