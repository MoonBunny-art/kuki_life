local function softFallGetGroundDistance(vehicle)
    if not vehicle or not vehicle.PrimaryPart then
        return nil
    end

    local root = vehicle.PrimaryPart

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {
        vehicle,
        player.Character
    }
    params.IgnoreWater = true

    local offsets = {
        Vector3.new(0, 0, 0),
        Vector3.new(SOFT_FALL_RAY_OFFSET, 0, 0),
        Vector3.new(-SOFT_FALL_RAY_OFFSET, 0, 0),
        Vector3.new(0, 0, SOFT_FALL_RAY_OFFSET),
        Vector3.new(0, 0, -SOFT_FALL_RAY_OFFSET),
        Vector3.new(SOFT_FALL_RAY_OFFSET, 0, SOFT_FALL_RAY_OFFSET),
        Vector3.new(-SOFT_FALL_RAY_OFFSET, 0, -SOFT_FALL_RAY_OFFSET)
    }

    local closestDistance = math.huge
    local closestResult = nil

    for _, offset in ipairs(offsets) do
        local origin = root.Position
            + root.CFrame:VectorToWorldSpace(offset)

        local result = workspace:Raycast(
            origin,
            Vector3.new(0, -SOFT_FALL_DETECTION_DISTANCE, 0),
            params
        )

        if result then
            local distance = origin.Y - result.Position.Y

            if distance >= 0 and distance < closestDistance then
                closestDistance = distance
                closestResult = result
            end
        end
    end

    if not closestResult then
        return nil
    end

    return closestDistance, closestResult
end

local function softFallStop(vehicle, humanoid, groundResult)
    if softFallBusy
        or not vehicle
        or not vehicle.PrimaryPart
        or not groundResult then
        return
    end

    softFallBusy = true

    local success, err = pcall(function()
        local root = vehicle.PrimaryPart

        if not root or root.Anchored then
            return
        end

        while softFallEnabled
            and vehicle.Parent
            and root.Parent do

            local deltaTime = RunService.Heartbeat:Wait()

            if not softFallEnabled or not root.Parent then
                break
            end

            local velocity = root.AssemblyLinearVelocity
            local fallSpeed = math.max(0, -velocity.Y)

            if velocity.Y >= SOFT_FALL_TARGET_SPEED then
                break
            end

            local distance = softFallGetGroundDistance(vehicle)

            if not distance then
                break
            end

            local dynamicBrakeDistance =
                SOFT_FALL_MIN_BRAKE_DISTANCE
                + fallSpeed * SOFT_FALL_SPEED_DISTANCE_FACTOR

            dynamicBrakeDistance = math.clamp(
                dynamicBrakeDistance,
                SOFT_FALL_MIN_BRAKE_DISTANCE,
                SOFT_FALL_MAX_BRAKE_DISTANCE
            )

            local safeDistance = math.max(
                distance - SOFT_FALL_GROUND_MARGIN,
                1
            )

            local requiredDeceleration =
                (
                    velocity.Y * velocity.Y
                    - SOFT_FALL_TARGET_SPEED
                    * SOFT_FALL_TARGET_SPEED
                ) / (2 * safeDistance)

            local deceleration = math.clamp(
                requiredDeceleration * 2,
                25,
                SOFT_FALL_MAX_DECELERATION
            )

            if distance <= dynamicBrakeDistance then
                local proximity = math.clamp(
                    1 - distance / dynamicBrakeDistance,
                    0,
                    1
                )

                deceleration = math.min(
                    SOFT_FALL_MAX_DECELERATION,
                    deceleration * (1 + proximity)
                )
            end

            local newY = math.min(
                SOFT_FALL_TARGET_SPEED,
                velocity.Y + deceleration * deltaTime
            )

            root.AssemblyLinearVelocity = Vector3.new(
                velocity.X,
                newY,
                velocity.Z
            )

            root.AssemblyAngularVelocity =
                root.AssemblyAngularVelocity:Lerp(
                    Vector3.zero,
                    math.clamp(
                        SOFT_FALL_SMOOTHING * deltaTime,
                        0,
                        1
                    )
                )

            if newY >= SOFT_FALL_TARGET_SPEED then
                break
            end
        end
    end)

    if not success then
        warn("[SoftFall] Fehler:", err)
    end

    softFallBusy = false
end

