local function createButton(
    name, text, y, baseColor, strokeColor, gradientColors
)
    local b = Instance.new("TextButton")
    b.Name = name
    b.Size = UDim2.new(1, -32, 0, 42)
    b.Position = UDim2.fromOffset(16, y)
    b.BackgroundColor3 = baseColor
    b.Text = text
    b.TextColor3 = WHITE
    b.TextSize = 16
    b.Font = Enum.Font.GothamBold
    b.AutoButtonColor = false
    b.BorderSizePixel = 0
    b.ZIndex = 5
    b.Parent = main

    addCorner(b, 13)
    local stroke = addStroke(b, strokeColor, 1.5)

    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, gradientColors[1]),
        ColorSequenceKeypoint.new(1, gradientColors[2])
    })
    gradient.Parent = b

    b.MouseEnter:Connect(function()
        if b.Parent then
            makeTween(stroke, 0.15, {Thickness = 2})
        end
    end)

    b.MouseLeave:Connect(function()
        if b.Parent then
            makeTween(stroke, 0.15, {Thickness = 1.5})
        end
    end)

    return b, stroke, gradient
end

