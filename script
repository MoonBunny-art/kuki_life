-- SPEED HACK
-- 1) Beim ersten Gasgeben wird die normale Top-Speed des Scooters gemessen
--    (keine Beschleunigung durch den Hack).
-- 2) Sobald die Speed MEASURE_STABLE_TIME Sekunden nicht mehr steigt,
--    wird sie als Top-Speed gespeichert.
-- 3) Danach fährt der Scooter Top-Speed + SPEED_BONUS_KMH
--    (z.B. 20 -> 45 km/h).
-- Walk Hack hat Vorrang, damit beide nicht gleichzeitig überschreiben.
local speedConnection

speedConnection = RunService.Heartbeat:Connect(function(dt)
    if not gui.Parent
        or not speedHackEnabled
        or walkHackEnabled then
        return
    end

    if not wPressed then
        -- Messung abbrechen, wenn W losgelassen wird, bevor sie fertig ist
        if not speedBaselineKmh then
            speedPeakKmh = 0
            speedLastIncrease = os.clock()
        end
        return
    end

    local vehicle, seat, humanoid = getVehicle()

    if not vehicle or not seat or not humanoid
        or humanoid.Health <= 0
        or not vehicle.PrimaryPart then
        return
    end

    local root = vehicle.PrimaryPart

    if root.Anchored then
        return
    end

    -- Anderes Fahrzeug -> neu messen
    if speedBaselineVehicle ~= vehicle then
        resetSpeedMeasure()
        speedBaselineVehicle = vehicle
    end

    local velocity = root.AssemblyLinearVelocity
    local horizontalVelocity = Vector3.new(velocity.X, 0, velocity.Z)

    -- MESSPHASE
    if not speedBaselineKmh then
        local currentKmh = horizontalVelocity.Magnitude
            * STUDS_TO_METERS * 3.6

        if currentKmh > speedPeakKmh + 0.5 then
            speedPeakKmh = currentKmh
            speedLastIncrease = os.clock()
        end

        if speedPeakKmh > 3
            and os.clock() - speedLastIncrease >= MEASURE_STABLE_TIME then
            speedBaselineKmh = speedPeakKmh
            speedMeasureShown = false
        else
            if not speedMeasureShown then
                status.Text = "MEASURING TOP SPEED..."
                status.TextColor3 = GREEN
                speedMeasureShown = true
            end
            return
        end
    end

    -- BOOST-PHASE
    if not speedMeasureShown then
        status.Text = string.format(
            "TOP %d +%d = %d KM/H",
            math.floor(speedBaselineKmh + 0.5),
            SPEED_BONUS_KMH,
            math.floor(speedBaselineKmh + SPEED_BONUS_KMH + 0.5)
        )
        status.TextColor3 = GREEN
        speedMeasureShown = true
    end

    local look = vehicle:GetPivot().LookVector
    local forward = Vector3.new(look.X, 0, look.Z)

    if forward.Magnitude < 0.001 then
        return
    end

    forward = forward.Unit

    local forwardSpeed = horizontalVelocity:Dot(forward)
    local sidewaysVelocity =
        horizontalVelocity - forward * forwardSpeed

    local maxSpeed = kmhToStudsPerSecond(
        speedBaselineKmh + SPEED_BONUS_KMH
    )
    local acceleration = kmhToStudsPerSecond(
        ACCELERATION_KMH_PER_SECOND
    )

    local newForwardSpeed = math.min(
        forwardSpeed + acceleration * dt,
        maxSpeed
    )

    local newHorizontalVelocity =
        forward * newForwardSpeed + sidewaysVelocity

    root.AssemblyLinearVelocity = Vector3.new(
        newHorizontalVelocity.X,
        velocity.Y,
        newHorizontalVelocity.Z
    )
end)

